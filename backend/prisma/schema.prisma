generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid()) @db.VarChar(191)
  name                String         @db.VarChar(120)
  email               String         @unique @db.VarChar(254)
  passwordHash        String         @map("password_hash") @db.VarChar(255)
  role                String         @default("member") @db.VarChar(20)
  nickname            String         @default("") @db.VarChar(120)
  phone               String         @default("") @db.VarChar(30)
  motorcycle          String         @default("") @db.VarChar(120)
  bloodType           String         @default("") @map("blood_type") @db.VarChar(4)
  birthDate           String         @default("") @map("birth_date") @db.VarChar(30)
  active              Boolean        @default(true)
  joinedAt            DateTime       @default(now()) @map("joined_at") @db.DateTime(3)
  eventRsvps          EventRsvp[]
  payments            Payment[]
  productOrders       ProductOrder[]
  approvedApplication Application?   @relation("ApprovedApplication")

  @@index([role, active])
  @@map("users")
}

model LoginAttempt {
  identifier  String    @id @db.VarChar(254)
  count       Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("login_attempts")
}

model ClubSettings {
  id           String  @id @default("club") @db.VarChar(32)
  clubName     String  @default("Biker 85 Girls") @map("club_name") @db.VarChar(160)
  tagline      String  @default("Moto Club") @db.VarChar(255)
  heroTitle    String  @default("Mulheres, motores e estrada sem fim") @map("hero_title") @db.VarChar(255)
  heroSubtitle String  @default("") @map("hero_subtitle") @db.Text
  aboutText    String  @default("") @map("about_text") @db.Text
  logoUrl      String  @default("/logo.png") @map("logo_url") @db.Text
  heroImage    String  @default("") @map("hero_image") @db.Text
  primaryColor String  @default("#e85a9b") @map("primary_color") @db.VarChar(20)
  accentColor  String  @default("#ff2a85") @map("accent_color") @db.VarChar(20)
  monthlyFee   Decimal @default(30.00) @map("monthly_fee") @db.Decimal(10, 2)
  city         String  @default("") @db.VarChar(160)
  foundedYear  String  @default("") @map("founded_year") @db.VarChar(20)
  contactEmail String  @default("") @map("contact_email") @db.VarChar(254)
  contactPhone String  @default("") @map("contact_phone") @db.VarChar(40)
  instagram    String  @default("") @db.VarChar(255)
  whatsapp     String  @default("") @db.VarChar(40)
  gallery      Json?

  @@map("club_settings")
}

model Event {
  id          String      @id @default(cuid()) @db.VarChar(191)
  title       String      @db.VarChar(255)
  type        String      @default("evento") @db.VarChar(30)
  date        String      @db.VarChar(30)
  location    String      @default("") @db.VarChar(255)
  description String      @default("") @db.Text
  imageUrl    String      @default("") @map("image_url") @db.Text
  createdBy   String      @default("") @map("created_by") @db.VarChar(120)
  createdAt   DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  rsvps       EventRsvp[]

  @@index([date])
  @@map("events")
}

model EventRsvp {
  eventId   String   @map("event_id") @db.VarChar(191)
  userId    String   @map("user_id") @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("event_rsvps")
}

model Payment {
  id     String    @id @default(cuid()) @db.VarChar(191)
  userId String    @map("user_id") @db.VarChar(191)
  year   Int
  month  Int
  paid   Boolean   @default(false)
  amount Decimal   @default(0.00) @db.Decimal(10, 2)
  paidAt DateTime? @map("paid_at") @db.DateTime(3)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([year, month, paid])
  @@map("payments")
}

model Application {
  id              String    @id @default(cuid()) @db.VarChar(191)
  name            String    @db.VarChar(120)
  email           String    @db.VarChar(254)
  whatsapp        String    @db.VarChar(30)
  age             Int?
  height          String    @default("") @db.VarChar(20)
  bloodType       String    @default("") @map("blood_type") @db.VarChar(4)
  city            String    @db.VarChar(120)
  profession      String    @default("") @db.VarChar(120)
  instagram       String    @default("") @db.VarChar(80)
  hasMotorcycle   Boolean   @default(false) @map("has_motorcycle")
  motorcycleModel String    @default("") @map("motorcycle_model") @db.VarChar(120)
  ridingSince     String    @default("") @map("riding_since") @db.VarChar(80)
  styles          Json
  frequency       String    @default("") @db.VarChar(80)
  otherGroup      Boolean   @default(false) @map("other_group")
  reason          String    @db.Text
  commitEvents    Boolean   @default(false) @map("commit_events")
  hasCnhA         Boolean   @default(false) @map("has_cnh_a")
  status          String    @default("pending") @db.VarChar(20)
  note            String    @default("") @db.Text
  reviewedBy      String    @default("") @map("reviewed_by") @db.VarChar(120)
  reviewedAt      DateTime? @map("reviewed_at") @db.DateTime(3)
  userId          String?   @unique @map("user_id") @db.VarChar(191)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user            User?     @relation("ApprovedApplication", fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([status, createdAt])
  @@map("applications")
}

model Product {
  id          String         @id @default(cuid()) @db.VarChar(191)
  name        String         @db.VarChar(120)
  description String         @default("") @db.Text
  imageUrl    String         @default("") @map("image_url") @db.Text
  price       Decimal        @default(0.00) @db.Decimal(10, 2)
  sizes       Json
  deadline    String         @default("") @db.VarChar(10)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  orders      ProductOrder[]

  @@index([active, createdAt])
  @@map("products")
}

model ProductOrder {
  id        String   @id @default(cuid()) @db.VarChar(191)
  productId String   @map("product_id") @db.VarChar(191)
  userId    String   @map("user_id") @db.VarChar(191)
  want      Boolean  @default(false)
  size      String   @default("") @db.VarChar(40)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
  @@map("product_orders")
}
